{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "dist",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "input": "src/styles",
      "glob": "**/*",
      "output": "styles"
    },
    {
      "input": "src/lib/button",
      "glob": "*.css",
      "output": "styles/components"
    }
  ]
}
