{
  "name": "@ui-forge/angular",
  "version": "0.1.0",
  "description": "Angular component library for UI Forge",
  "type": "module",
  "main": "./dist/fesm2022/ui-forge-angular.mjs",
  "module": "./dist/fesm2022/ui-forge-angular.mjs",
  "es2020": "./dist/fesm2020/ui-forge-angular.mjs",
  "esm2020": "./dist/esm2020/ui-forge-angular.mjs",
  "typings": "./dist/index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "esm2020": "./dist/esm2020/ui-forge-angular.mjs",
      "es2020": "./dist/fesm2020/ui-forge-angular.mjs",
      "default": "./dist/fesm2022/ui-forge-angular.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "dev": "ng-packagr -p ng-package.json --watch",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@angular/common": "^17.0.0 || ^18.0.0",
    "@angular/core": "^17.0.0 || ^18.0.0"
  },
  "dependencies": {
    "@ui-forge/tokens": "*",
    "@ui-forge/core": "*",
    "class-variance-authority": "^0.7.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/common": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/compiler-cli": "^18.2.13",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.4.2",
    "ng-packagr": "^18.2.1",
    "rxjs": "^7.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.5.0",
    "zone.js": "~0.14.10"
  },
  "keywords": ["angular", "components", "ui", "design-system"],
  "license": "MIT"
}
