{
  "name": "@ui-forge/core",
  "version": "0.1.0",
  "description": "Core utilities and theme management for UI Forge",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
